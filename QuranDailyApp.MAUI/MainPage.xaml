<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="QuranDailyApp.MAUI.MainPage"
             Title="Tanzil: Daily Quran"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundPrimary}, Dark={StaticResource BackgroundPrimaryDark}}">

    <Shell.FlyoutBehavior>
        <FlyoutBehavior>Flyout</FlyoutBehavior>
    </Shell.FlyoutBehavior>

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior
            StatusBarColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
            StatusBarStyle="{AppThemeBinding Light=Light, Dark=Dark}" />
    </ContentPage.Behaviors>

    <!-- Main Grid Container -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <!-- Scrollable Content Area -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">
                
                <!-- Header Section -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <!-- Header Text -->
                    <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="Daily Verse" 
                               Style="{StaticResource Headline}"
                               HorizontalOptions="Center"/>
                        <Label x:Name="DateLabel" 
                               Text="Loading..."
                               Style="{StaticResource SecondaryText}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    
                    <!-- Today Button -->
                    <Button Grid.Column="1" 
                            x:Name="TodayButton"
                            Text="Today"
                            Clicked="OnTodayClicked"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            WidthRequest="80"
                            HeightRequest="60"/>
                </Grid>

                <!-- Loading Indicator -->
                <ActivityIndicator x:Name="LoadingIndicator" 
                                 IsVisible="True" 
                                 IsRunning="True"
                                 Color="{StaticResource Primary}"
                                 VerticalOptions="Center"
                                 HorizontalOptions="Center"/>

                <!-- Verse Card -->
                <Border x:Name="VerseCard" 
                        IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundCard}, Dark={StaticResource BackgroundCardDark}}"
                        Stroke="{StaticResource BorderColor}"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="20">

                        <!-- Verse Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Surah Badge -->
                            <Border Grid.Column="0"
                                    BackgroundColor="{StaticResource Primary}"
                                    Padding="12,8"
                                    HorizontalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8"/>
                                </Border.StrokeShape>
                                <VerticalStackLayout>
                                    <Label x:Name="SurahNameLabel" 
                                           Text="AL-FĀTIḤAH"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"/>
                                    <Label x:Name="SurahReferenceLabel" 
                                           Text="1:1"
                                           TextColor="White"
                                           FontSize="12"
                                           Opacity="0.9"
                                           HorizontalOptions="Center"/>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Bookmark Button -->
                            <Button Grid.Column="1" 
                                    x:Name="BookmarkButton"
                                    Clicked="OnBookmarkClicked"
                                    ImageSource="bookmark_outline.png"
                                    BackgroundColor="Transparent"
                                    BorderColor="{StaticResource BorderColor}"
                                    BorderWidth="1"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    CornerRadius="25"
                                    Margin="0,0,10,0">
                            </Button>

                            <!-- Share Button -->
                            <Button Grid.Column="2" 
                                    x:Name="ShareButton"
                                    Clicked="OnShareClicked"
                                    ImageSource="share_variant.png"
                                    BackgroundColor="Transparent"
                                    BorderColor="{StaticResource BorderColor}"
                                    BorderWidth="1"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    CornerRadius="25">
                            </Button>
                        </Grid>

                        <!-- Arabic Text -->
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundSecondary}, Dark={StaticResource BackgroundSecondaryDark}}"
                                Padding="20">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label x:Name="ArabicLabel" 
                                   Text="بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ"
                                   Style="{StaticResource ArabicText}"
                                   HorizontalTextAlignment="Center"
                                   FlowDirection="RightToLeft"/>
                        </Border>

                        <!-- Transliteration -->
                        <Label x:Name="TransliterationLabel" 
                               Text="bi-smi llāhi r-raḥmāni r-raḥīmi"
                               Style="{StaticResource TransliterationText}"
                               HorizontalTextAlignment="Center"/>

                        <!-- Translation -->
                        <VerticalStackLayout>
                            <Label x:Name="TranslationLabel" 
                                   Text="In the Name of Allah, the All-beneficent, the All-merciful."
                                   FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Fixed Navigation Buttons at Bottom -->
        <Grid Grid.Row="1" 
              x:Name="NavigationGrid" 
              IsVisible="False"
              ColumnSpacing="10"
              Padding="20,10,20,20"
              BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundPrimary}, Dark={StaticResource BackgroundPrimaryDark}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="PreviousButton" 
                    Clicked="OnPreviousClicked"
                    ImageSource="chevron_left.png"
                    Style="{StaticResource Key=Button}">
            </Button>
            
            <Button Grid.Column="1"
                    x:Name="RandomButton"
                    Text="Random" 
                    Clicked="OnRandomClicked"
                    Style="{StaticResource Key=Button}"/>

            <Button Grid.Column="2"
                    x:Name="NextButton"
                    Clicked="OnNextClicked" 
                    ImageSource="chevron_right.png"
                    Style="{StaticResource Key=Button}">
            </Button>
        </Grid>
        
    </Grid>

</ContentPage>